# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_NAME="SI-GEOMEDIK Kemhan RI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (Drizzle ORM with LibSQL/SQLite)
# Local: file:local.db
# Production / Turso: libsql://[db-name]-[org].turso.io?authToken=[token]
# -----------------------------------------------------------------------------
DATABASE_URL=file:local.db

# -----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# Generate with: openssl rand -base64 32
# -----------------------------------------------------------------------------
AUTH_SECRET=change-this-to-a-very-secure-random-secret-key-in-production-32chars

# -----------------------------------------------------------------------------
# CARTO LOCATION INTELLIGENCE API (Modul 2, 14, 15)
# Region: gcp-asia-northeast1
# Salin berkas ini ke .env.local dan isi CARTO_API_TOKEN Anda
# -----------------------------------------------------------------------------
CARTO_API_BASE_URL=https://gcp-asia-northeast1.api.carto.com
CARTO_ACCOUNT_ID=ac_i59iz3dh
CARTO_API_TOKEN=your-carto-api-access-token-here
